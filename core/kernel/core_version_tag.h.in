/* Generated by meson vcs_tag from `git describe --tags --abbrev=0`; do not
 * edit the .h. The nearest release tag alone ("v0.1.0"), with no commit count
 * and no hash — the string Settings > About puts in its "Core" chip. An
 * untagged tree falls back to "v0.0.0". The full build id, hash and all, is
 * CORE_BUILD_ID in core_version.h. */
#ifndef CORE_VERSION_TAG_H
#define CORE_VERSION_TAG_H
#define CORE_VERSION "@VCS_TAG@"
#endif
